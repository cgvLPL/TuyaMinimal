# Copy to .env.local for `vercel dev`. Set the same values in Vercel > Project > Settings > Environment Variables.
TUYA_CLIENT_ID=your_access_id
TUYA_CLIENT_SECRET=your_access_secret
TUYA_UID=uid_of_your_linked_tuya_app_account
# us (Western America), us-e (Eastern America), eu (Central Europe), eu-w (Western Europe), sg (Singapore), in (India), cn (China)
TUYA_REGION=eu
# Long and unique: anyone with your URL and this password can control your devices.
APP_PASSWORD=choose-a-long-passphrase
# Optional: device ID(s) of your IR blaster, if it is not detected automatically
# TUYA_IR_HUB=
